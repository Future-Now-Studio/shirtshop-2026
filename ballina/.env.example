# ── Ballina B2B Portal – environment variables ─────────────────────────────
# Copy to ".env" for local dev. On the host (Netlify) set the SAME keys under
# Site settings → Environment variables.

# --- Auth + orders (Supabase) -----------------------------------------------
# Build-time vars (VITE_ prefix → embedded in the browser bundle; anon key is
# public by design, protected by Row Level Security).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>

# Mock mode: "true" runs auth + orders without a live Supabase project.
# Set to "false" (or remove) once the two vars above point at the real project.
VITE_USE_MOCK=false

# --- Catalogue (WooCommerce) ------------------------------------------------
# Server-side only — read by the Vite dev proxy AND the Netlify function
# (netlify/functions/wc-proxy.mjs). NEVER give these a VITE_ prefix.
WC_BASE_URL=https://timob10.sg-host.com/wp-json/wc/v3
WC_CONSUMER_KEY=<ck_...>
WC_CONSUMER_SECRET=<cs_...>
